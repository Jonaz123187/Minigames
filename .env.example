# Public website address. Firebase Auth must authorize this domain in its console.
PUBLIC_URL=https://multiplayergames-gig.onrender.com
# PREFERRED ON RENDER: add firebase-admin.json under Environment > Secret Files.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
# Alternative to the secret file: entire Firebase service-account JSON as one variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Exact Firebase UIDs, comma separated; never use email addresses as owner identifiers.
OWNER_UIDS=
SUPABASE_URL=https://goycxzibucgklomlgyij.supabase.co
# Supabase Settings > API Keys > secret key (sb_secret_...). SERVER ONLY.
SUPABASE_SECRET_KEY=
# Optional long random string; stabilizes signed guest identifiers across restarts.
# GUEST_COOKIE_SECRET=
PORT=3000
